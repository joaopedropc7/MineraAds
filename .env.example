# Copie este arquivo para ".env" e cole sua chave grátis do urlscan.io
# (urlscan.io > Sign up > Settings & API > New API key). Opcional para buscar,
# obrigatória para --detalhar.
URLSCAN_API_KEY=

# Opcional: chave grátis do Google para medir o tráfego dos sites fora do top 1 milhão
# (passo a passo no LEIA-ME, seção "Tráfego").
CRUX_API_KEY=

# Opcional e PAGO: chave do plano de US$ 50/mês do CertSpotter (sslmate.com/ct_search_api).
# Sobe a vigia de certificados de 10 para 100 domínios por hora. O grátis já funciona sem chave.
CERTSPOTTER_API_KEY=
